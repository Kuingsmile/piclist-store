{
  "name": "@piclist/store",
  "version": "3.0.1",
  "description": "A  simple and efficient key-value store for piclist, supporting JSON and binary data.",
  "homepage": "https://github.com/Kuingsmile/piclist-store#readme",
  "bugs": {
    "url": "https://github.com/Kuingsmile/piclist-store/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kuingsmile/piclist-store.git"
  },
  "license": "MIT",
  "author": "Kuingsmile",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md",
    "License"
  ],
  "scripts": {
    "benchmark": "node scripts/benchmark.mjs",
    "build": "rollup -c",
    "clean": "rimraf dist",
    "cz": "git-cz",
    "dev": "rollup -c -w",
    "lint": "eslint --fix",
    "lint:check": "eslint",
    "prepare": "husky",
    "prepublishOnly": "yarn run clean && yarn run build",
    "release": "bump-version",
    "repro:bugs": "npm run build && node scripts/reproduce-bugs.mjs",
    "test": "node ./test_db.js",
    "test:compat": "node scripts/check-compatibility.mjs",
    "test:package": "node scripts/check-package.mjs",
    "test:unit": "node --test tests/*.test.mjs",
    "test:regressions": "node scripts/reproduce-bugs.mjs --verify-fixed",
    "test:types": "tsc --ignoreConfig --noEmit --strict --module nodenext --target es2022 --skipLibCheck tests/types/consumer.ts"
  },
  "config": {
    "commitizen": {
      "path": "cz-customizable"
    },
    "cz-customizable": {
      "config": ".cz-config.cjs"
    }
  },
  "resolutions": {
    "baseline-browser-mapping": "^2.11.23"
  },
  "dependencies": {
    "comment-json": "^5.0.0",
    "fflate": "^0.8.3",
    "fs-extra": "^11.4.0",
    "lodash": "^4.18.1",
    "lowdb": "^7.0.1",
    "tslib": "^2.8.1",
    "write-file-atomic": "^7.0.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/fs-extra": "^11.0.4",
    "@types/lodash": "^4.17.25",
    "@types/node": "^22.20.2",
    "@types/write-file-atomic": "^4.0.3",
    "commitizen": "^4.3.2",
    "cz-customizable": "^7.5.4",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsonc": "^3.4.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unicorn": "^74.0.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "node-bump-version": "3.0.0",
    "prettier": "3.9.6",
    "rimraf": "^6.1.3",
    "rollup": "^4.63.2",
    "rollup-plugin-dts": "~6.4.1",
    "store-legacy": "npm:@piclist/store@3.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  },
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bumpVersion": {
    "preset": "emoji"
  }
}
