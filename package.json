{
  "name": "@piclist/store",
  "version": "3.0.1",
  "description": "A  simple and efficient key-value store for piclist, supporting JSON and binary data.",
  "homepage": "https://github.com/Kuingsmile/piclist-store#readme",
  "bugs": {
    "url": "https://github.com/Kuingsmile/piclist-store/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kuingsmile/piclist-store.git"
  },
  "license": "MIT",
  "author": "Kuingsmile",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "rollup -c",
    "clean": "rimraf dist",
    "cz": "git-cz",
    "dev": "rollup -c -w",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "prepare": "husky",
    "prepublishOnly": "yarn run clean && yarn run build",
    "release": "bump-version",
    "test": "node ./test_db.js"
  },
  "config": {
    "commitizen": {
      "path": "cz-customizable"
    },
    "cz-customizable": {
      "config": ".cz-config.cjs"
    }
  },
  "resolutions": {
    "baseline-browser-mapping": "^2.9.13"
  },
  "dependencies": {
    "comment-json": "^4.5.1",
    "fflate": "^0.8.2",
    "fs-extra": "^11.3.3",
    "lodash": "^4.17.21",
    "lowdb": "^6.1.1",
    "tslib": "^2.8.1",
    "write-file-atomic": "^7.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/fs-extra": "^11.0.4",
    "@types/lodash": "^4.17.21",
    "@types/node": "^25.0.3",
    "@types/write-file-atomic": "^4.0.3",
    "@typescript-eslint/eslint-plugin": "8.52.0",
    "commitizen": "^4.3.2",
    "cz-customizable": "^7.5.4",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsonc": "^3.4.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unicorn": "^74.0.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "node-bump-version": "3.0.0",
    "prettier": "3.9.4",
    "rimraf": "^6.1.3",
    "rollup": "^4.55.1",
    "rollup-plugin-dts": "^6.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bumpVersion": {
    "preset": "emoji"
  }
}
